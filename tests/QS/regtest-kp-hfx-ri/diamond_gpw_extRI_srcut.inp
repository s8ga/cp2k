&GLOBAL
  PRINT_LEVEL MEDIUM
  PROJECT diamond_gpw_extRI_srcut
  RUN_TYPE ENERGY
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_RI_cc-TZ
    POTENTIAL_FILE_NAME POTENTIAL
    SORT_BASIS EXP
    &KPOINTS
      SCHEME MONKHORST-PACK 2 2 2
    &END KPOINTS
    &MGRID
      CUTOFF 120
      REL_CUTOFF 30
    &END MGRID
    &QS
      METHOD GPW
      PW_GRID_BLOCKED FALSE
    &END QS
    &SCF
      IGNORE_CONVERGENCE_FAILURE
      MAX_SCF 2
      SCF_GUESS ATOMIC
    &END SCF
    &XC
      &HF
        &INTERACTION_POTENTIAL
          !short-range potential with an explicit CUTOFF_RADIUS: the k-point RI path
          !must honor the explicit value instead of silently overwriting it
          POTENTIAL_TYPE SHORTRANGE
          OMEGA 0.11
          CUTOFF_RADIUS 4.0
        &END INTERACTION_POTENTIAL
        &RI
          EPS_FILTER 1.0E-10
          MEMORY_CUT 2
          NGROUPS 2
        &END RI
      &END HF
      &XC_FUNCTIONAL NONE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      !this is not a realistic cell, but denser systems would be too expensive for a test
      ABC 7.5 7.5 7.5
      ALPHA_BETA_GAMMA 60.0 60.0 60.0
    &END CELL
    &COORD
      SCALED
      C   0.00000000  0.00000000  0.00000000
      C   0.25000000  0.25000000  0.25000000
    &END COORD
    &KIND C
      BASIS_SET cc-DZ
      BASIS_SET RI_HFX RI_DZ
      POTENTIAL GTH-HF
    &END KIND
    &TOPOLOGY
    &END TOPOLOGY
  &END SUBSYS
&END FORCE_EVAL
